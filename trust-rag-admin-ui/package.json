    "@vitejs/plugin-vue": "6.0.7",
    "@vue/test-utils": "2.4.11",
    "jsdom": "29.1.1",
    "msw": "2.14.6",
    "typescript": "6.0.3",
    "vite": "8.0.16",
    "vitest": "4.1.9",
